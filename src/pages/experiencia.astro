---
import CvLayout from '../layouts/cvLayout.astro'
---

<CvLayout>
  <title slot="titulo">CV — Experiencia</title>

  <h1 class="mt-6 flex items-center justify-center gap-2 text-center text-2xl font-bold text-neutral-900">
    Experiencia Profesional
  </h1>

  <details open class="mb-8 bg-yellow-300 py-2">
    <summary class="bg-purple-900 px-1 py-1 text-xl leading-tight text-white">
      <strong>Operaria textil | Fit Tèxtil E.I.S.L., Barcelona (marzo 2023 – 2026)</strong> (3 años de experiencia)
    </summary>
    <p class="m-1 text-center">
      Coordinación de procesos operativos y garantía de estándares de calidad en producción.
    </p>
  </details>

  <details class="mb-8 bg-yellow-300 py-2">
    <summary class="bg-purple-900 px-1 py-1 text-xl leading-tight text-white">
      <strong>Asistente de servicio | Real Club de Polo Barcelona / Freelance (2022 – 2023)</strong> (1 año de experiencia)
    </summary>
    <p class="m-1 text-center">
      Atención personalizada y gestión de servicios en eventos internacionales de alto nivel.
    </p>
  </details>

  <details class="mb-8 bg-yellow-300 py-2">
    <summary class="bg-purple-900 px-1 py-1 text-xl leading-tight text-white">
      <strong>Dependienta | Tienda de alimentación, Duala, Camerún (2017 – 2018)</strong> (1 año de experiencia)
    </summary>
    <p class="m-1 text-center">
      Gestión de ventas, inventario y atención directa al público
    </p>
  </details>
</CvLayout>