---
import CvLayout from '../layouts/cvLayout.astro'
---

<CvLayout>
  <title slot="titulo">CV — Tecnologías</title>

  <h1 class="mt-6 flex flex-wrap items-center justify-center gap-2 text-center text-2xl font-bold text-neutral-900">
    Tecnologías
  </h1>

  <ul class="mx-auto my-5 w-fit max-w-full list-disc space-y-3 rounded-lg bg-yellow-400/90 px-8 pb-6 pt-5 text-left leading-relaxed shadow-lg">
    <li>
      Editor y herramientas
      <ol class="mt-1 list-decimal space-y-0.5 pl-5">
        <li>Visual Studio Code</li>
      </ol>
    </li>
    <li>
      Desarrollo web
      <ol class="mt-1 list-decimal space-y-0.5 pl-5">
        <li>HTML</li>
        <li>CSS</li>
        <li>Tailwind CSS</li>
        <li>JavaScript</li>
        <li>Node.js</li>
        <li>React</li>
        <li>Astro</li>
        <li>Markdown</li>
      </ol>
    </li>
    <li>
      Intercambio de datos
      <ol class="mt-1 list-decimal space-y-0.5 pl-5">
        <li>JSON</li>
        <li>XML</li>
        <li>YAML</li>
        <li>APIs</li>
      </ol>
    </li>
    <li>
      Control de versiones
      <ol class="mt-1 list-decimal space-y-0.5 pl-5">
        <li>Git</li>
        <li>GitHub</li>
      </ol>
    </li>
    <li>
      Bases de datos
      <ol class="mt-1 list-decimal space-y-0.5 pl-5">
        <li>MongoDB</li>
        <li>PostgreSQL</li>
      </ol>
    </li>
    <li>
      Material complementario
      <ol class="mt-1 list-decimal space-y-0.5 pl-5">
        <li>WordPress</li>
      </ol>
    </li>
  </ul>
</CvLayout>